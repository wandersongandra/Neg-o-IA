# Variáveis de ambiente. Copie para .env e ajuste os valores.
# Segredos não devem ser commitados. Este arquivo é apenas um template.

# Aplicação
NEGAO_APP_NAME=negao-ai
NEGAO_ENV=development
NEGAO_DEBUG=true
NEGAO_LOG_LEVEL=INFO
NEGAO_API_PREFIX=/api/v1
# Credencial bootstrap de serviço: em produção fica DESATIVADA por padrão.
# Para provisionar a primeira chave persistida, habilite temporariamente,
# crie uma chave rotacionável via /database/api-keys e desabilite novamente.
NEGAO_SERVICE_BOOTSTRAP_ENABLED=false
NEGAO_SERVICE_API_KEY=CHANGE_ME_SERVICE_KEY
NEGAO_SERVICE_API_SCOPES=database:admin,metrics:read
NEGAO_REGISTRATION_ENABLED=true
# Sessões: expiração absoluta + expiração por inatividade + limite por usuário
NEGAO_AUTH_SESSION_TTL_SECONDS=28800
NEGAO_AUTH_SESSION_IDLE_SECONDS=1800
NEGAO_AUTH_MAX_ACTIVE_SESSIONS=5
NEGAO_AUTH_SESSION_TOUCH_INTERVAL_SECONDS=60
# Em produção, se vazio, os hosts são derivados de NEGAO_CORS_ORIGINS.
NEGAO_TRUSTED_HOSTS=

# Banco de dados (PostgreSQL + pgvector)
# Os hosts são os nomes dos serviços no Docker Compose.
NEGAO_DATABASE_URL=postgresql+asyncpg://negao:CHANGE_ME_POSTGRES_PASSWORD@db:5432/negao
NEGAO_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Segurança
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
NEGAO_SECRET_KEY=substitua-por-chave-aleatoria-de-32-bytes
# Alternativa recomendada em produção: use somente *_FILE, sem valor direto.
# SOPHIE_SECRET_KEY_FILE=/run/secrets/sophie_secret_key
# SOPHIE_DATABASE_URL_FILE=/run/secrets/sophie_database_url
# SOPHIE_REDIS_URL_FILE=/run/secrets/sophie_redis_url
# SOPHIE_AUDIT_INTEGRITY_KEY_FILE=/run/secrets/sophie_audit_integrity_key
# SOPHIE_NVIDIA_API_KEY_FILE=/run/secrets/sophie_nvidia_api_key
# Segredo compartilhado SOMENTE entre o Next BFF e o backend para autenticar
# X-Real-IP/X-Forwarded-For internos. Use outro valor aleatório e independente.
NEGAO_INTERNAL_PROXY_KEY=CHANGE_ME_INTERNAL_PROXY_KEY

# Auditoria tamper-evident
# Opcional: use uma chave dedicada. Se vazia, deriva da NEGAO_SECRET_KEY.
NEGAO_AUDIT_INTEGRITY_KEY=
# Durante rotação, mantenha chaves antigas separadas por vírgula até concluir a transição.
NEGAO_AUDIT_INTEGRITY_PREVIOUS_KEYS=

# CORS
NEGAO_CORS_ORIGINS=http://localhost:3000

# Observabilidade
NEGAO_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
NEGAO_METRICS_ENABLED=true

# Rate limiting
# Limite global de requisições por minuto por IP (todas as rotas HTTP)
NEGAO_RATE_LIMIT_PER_MINUTE=60
# Limite mais apertado (burst) para endpoints sensíveis (auth/WebSocket)
NEGAO_RATE_LIMIT_BURST=5
# Máximo de conexões WebSocket simultâneas
NEGAO_WS_MAX_CONNECTIONS=100

# Modelos e speech providers
# Privacidade: mantenha false até autorizar envio de texto/áudio a provedores externos.
NEGAO_EXTERNAL_AI_ENABLED=false
# Gere em: https://build.nvidia.com — escopo de chamada de API. Sem chave,
# o Brain degrada para respostas locais (mock) e a voz avisa que não há STT.
NEGAO_NVIDIA_API_KEY=
NEGAO_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Allowlist exata de hosts externos autorizados para Brain/STT/Vision.
NEGAO_EXTERNAL_AI_ALLOWED_HOSTS=integrate.api.nvidia.com
# Limite máximo aceito de resposta JSON dos provedores externos.
NEGAO_PROVIDER_MAX_RESPONSE_BYTES=2097152
NEGAO_BRAIN_CHAT_MODEL=nvidia/gpt-oss-120b
NEGAO_BRAIN_FALLBACK_MODEL=nvidia/llama-3.1-8b-instruct
NEGAO_BRAIN_STT_MODEL=nvidia/parakeet-tdt-0.6b-v2
# Opcional: informe um modelo multimodal compatível com o seu provedor.
# Se vazio, a Vision permanece indisponível mesmo com IA externa habilitada.
NEGAO_BRAIN_VISION_MODEL=
NEGAO_BRAIN_TEMPERATURE=0.3
NEGAO_BRAIN_MAX_TOKENS=1024
NEGAO_BRAIN_RETRY_ATTEMPTS=2
NEGAO_BRAIN_CIRCUIT_FAILURES=3
NEGAO_BRAIN_CIRCUIT_COOLDOWN_SECONDS=60
NEGAO_BRAIN_CACHE_TTL_SECONDS=300

# Vision
NEGAO_VISION_MAX_IMAGE_BYTES=8388608
NEGAO_VISION_TIMEOUT_SECONDS=45
NEGAO_VISION_MAX_PROMPT_CHARS=4000

# Voz (STT/TTS)
# edge-tts envia o texto ao provedor externo; em produção requer opt-in explícito.
NEGAO_EXTERNAL_TTS_ENABLED=false
# TTS via edge-tts (vozes neurais Microsoft, PT-BR)
NEGAO_TTS_VOICE=pt-BR-FranciscaNeural
NEGAO_TTS_RATE=+0%

# Conversação + recuperação de contexto
NEGAO_CONVERSATION_MAX_CONTEXT_MESSAGES=20
NEGAO_MEMORY_RECALL_LIMIT=5
NEGAO_KNOWLEDGE_RECALL_LIMIT=5
NEGAO_RETRIEVAL_MIN_SCORE=0.12
NEGAO_RETRIEVAL_CONTEXT_MAX_CHARS=6000

# Planner
NEGAO_PLANNER_PLAN_TTL_SECONDS=3600
NEGAO_PLANNER_MAX_STEPS=5
NEGAO_PLANNER_MAX_REPLANS=2

# Tool Manager
NEGAO_TOOL_MAX_CONCURRENCY=8
NEGAO_TOOL_TIMEOUT_SECONDS=10
NEGAO_TOOL_CIRCUIT_FAILURES=3
NEGAO_TOOL_CIRCUIT_COOLDOWN_SECONDS=30

# Frontend (dashboard Next.js)
# URL do backend usada pelo proxy server-side (/api/dashboard) — nunca exposta ao browser
NEGAO_API_URL=http://localhost:8000
# Origem pública canônica do browser em produção.
SOPHIE_PUBLIC_ORIGIN=https://sophie.example.com
# Mesmo segredo interno configurado no backend; nunca NEXT_PUBLIC_*.
SOPHIE_INTERNAL_PROXY_KEY=CHANGE_ME_INTERNAL_PROXY_KEY
# Ou use apenas:
# SOPHIE_INTERNAL_PROXY_KEY_FILE=/run/secrets/sophie_internal_proxy_key
# O proxy BFF só aceita a chave de serviço fora de produção.

# PWA e notificações push (VAPID)
# Gere com: npx web-push generate-vapid-keys
# Chave pública vai no frontend (NEXT_PUBLIC_VAPID_PUBLIC_KEY)
# Chave privada fica SÓ no backend
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# PostgreSQL (container)
POSTGRES_USER=negao
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=negao
PGDATA=/var/lib/postgresql/data/pgdata

# Grafana (container)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-local

# Geral
TZ=America/Sao_Paulo

# Backups criptografados (arquivo local com permissao 0600)
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/sophie_backup_key

# TLS do Nginx em producao
TLS_CERT_PATH=/etc/letsencrypt/live/sophie.example/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/sophie.example/privkey.pem
# Hostname público aceito pelo Nginx, sem esquema.
SOPHIE_HOST=sophie.example.com
